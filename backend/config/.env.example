NODE_ENV=development
PORT=8787
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/ExtractIQ

# Copy this file to config/.env and put your real key there.
# The app ONLY reads config/.env — never this example file.
# Create a Console API key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Required to list/download shared Google Drive links.
# Create an API key in Google Cloud Console with Drive API enabled.
# Folders/files must be shared as "Anyone with the link".
# GOOGLE_DRIVE_API_KEY=

# Optional. Defaults live in src/services/extract/engine/shared/constants.ts.
# RECORD_MODEL=claude-sonnet-4-5
# DOCUMENT_MODEL=claude-haiku-5-5
