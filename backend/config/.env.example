NODE_ENV=development
PORT=8787
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/ExtractIQ
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Copy this file to config/.env and put your real key there.
# The app ONLY reads config/.env — never this example file.
# Create a Console API key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Required to list/download shared Google Drive links.
# Create an API key in Google Cloud Console with Drive API enabled.
# Folders/files must be shared as "Anyone with the link".
# GOOGLE_DRIVE_API_KEY=

# Required for OneDrive connect (delegated OAuth) + optional share-link import.
# Azure App Registration → Application (client) ID, client secret Value.
# Supported account types: "Accounts in any org directory and personal Microsoft accounts".
# Delegated permissions: Files.Read, Files.Read.All, User.Read, offline_access.
# Authentication → Web redirect URI must match MS_REDIRECT_URI exactly.
# Use MS_TENANT_ID=common so personal Outlook/OneDrive accounts can sign in.
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT_ID=common
# MS_REDIRECT_URI=http://localhost:8787/api/onedrive/callback
# MS_FRONTEND_REDIRECT=http://localhost:5173/

# Optional. Defaults live in src/services/extract/engine/shared/constants.ts.
# RECORD_MODEL=claude-sonnet-4-5
# DOCUMENT_MODEL=claude-haiku-5-5
